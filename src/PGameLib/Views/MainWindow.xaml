<Window x:Class="PGameLib.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PGameLib.ViewModels"
        xmlns:models="clr-namespace:PGameLib.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="PGameLib"
        Width="1180" Height="760" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding PlayCommand}" CommandParameter="{Binding SelectedGame}" />
        <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedGame}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <!-- ======== Grid card template ======== -->
        <DataTemplate x:Key="GameCardTemplate" DataType="{x:Type vm:GameCardViewModel}">
            <Border Width="196" Margin="8" CornerRadius="12" Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <!-- Art -->
                    <Grid Height="112">
                        <Border CornerRadius="12,12,0,0" ClipToBounds="True">
                            <Grid>
                                <!-- Placeholder behind -->
                                <Border Background="#20242F">
                                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                                               Foreground="#3A4150" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Image Source="{Binding DisplayImagePath, Converter={StaticResource PathToImage}}"
                                       Stretch="Uniform" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>

                        <!-- Source pill -->
                        <Border Background="{Binding Source, Converter={StaticResource SourceBrush}}"
                                CornerRadius="6" Padding="7,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="{Binding SourceText}" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
                        </Border>

                        <!-- Missing badge -->
                        <Border Background="#66000000" CornerRadius="12,12,0,0"
                                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <Border Background="{StaticResource WarnBrush}" CornerRadius="6" Padding="8,3"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Missing" FontSize="11" FontWeight="SemiBold" Foreground="#120D02" />
                            </Border>
                        </Border>
                    </Grid>

                    <!-- Text -->
                    <StackPanel Margin="12,10,12,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Subtle}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Primary action -->
                    <Grid Margin="12,10,12,0">
                        <Button Content="▶  Play" Style="{StaticResource PlayButton}" Height="36"
                                Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Locate…" Style="{StaticResource AccentButton}" Height="36"
                                Command="{Binding DataContext.LocateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </Grid>

                    <!-- Secondary actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,10">
                        <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="Open folder"
                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Edit"
                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove from library"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- ======== List row template ======== -->
        <DataTemplate x:Key="GameRowTemplate" DataType="{x:Type vm:GameCardViewModel}">
            <Border Margin="0,4" Padding="12,10" CornerRadius="10" Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Grid Grid.Column="0" Width="44" Height="44">
                        <Border Background="#20242F" CornerRadius="8">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="#3A4150" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding DisplayImagePath, Converter={StaticResource PathToImage}}"
                               Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>

                    <!-- Name + path -->
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                            <Border Background="{StaticResource WarnBrush}" CornerRadius="5" Padding="6,1" Margin="8,0,0,0"
                                    Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                <TextBlock Text="Missing" FontSize="10" FontWeight="SemiBold" Foreground="#120D02" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding InstallFolder}" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Source pill -->
                    <Border Grid.Column="2" VerticalAlignment="Center" Background="{Binding Source, Converter={StaticResource SourceBrush}}"
                            CornerRadius="6" Padding="8,3" Margin="8,0">
                        <TextBlock Text="{Binding SourceText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </Border>

                    <!-- Size -->
                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Subtle}"
                               VerticalAlignment="Center" MinWidth="70" TextAlignment="Right" Margin="8,0,12,0" />

                    <!-- Actions -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="▶ Play" Style="{StaticResource PlayButton}" Height="34" Padding="14,0" Margin="0,0,6,0"
                                Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Locate…" Style="{StaticResource AccentButton}" Height="34" Padding="14,0" Margin="0,0,6,0"
                                Command="{Binding DataContext.LocateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="Open folder"
                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Edit"
                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Transparent list containers for both views -->
        <Style x:Key="GameListContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22283A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ===================== Layout ===================== -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,20,0,20">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="My Game" FontWeight="SemiBold" FontSize="15" LineHeight="16" />
                        <TextBlock Text="Library" FontWeight="SemiBold" FontSize="15" LineHeight="16" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Nav -->
                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                    <TextBlock Text="BROWSE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="18,2,0,6" />
                    <RadioButton Style="{StaticResource SidebarNav}" GroupName="nav" Content="Library" Tag="&#xE1D3;"
                                 IsChecked="{Binding CurrentFilter, Converter={StaticResource EqBool}, ConverterParameter=All}" />
                    <RadioButton Style="{StaticResource SidebarNav}" GroupName="nav" Content="Steam" Tag="&#xE909;"
                                 IsChecked="{Binding CurrentFilter, Converter={StaticResource EqBool}, ConverterParameter=Steam}" />
                    <RadioButton Style="{StaticResource SidebarNav}" GroupName="nav" Content="Epic" Tag="&#xE909;"
                                 IsChecked="{Binding CurrentFilter, Converter={StaticResource EqBool}, ConverterParameter=Epic}" />
                    <RadioButton Style="{StaticResource SidebarNav}" GroupName="nav" Content="Standalone" Tag="&#xE7B8;"
                                 IsChecked="{Binding CurrentFilter, Converter={StaticResource EqBool}, ConverterParameter=Standalone}" />
                    <RadioButton Style="{StaticResource SidebarNav}" GroupName="nav" Content="Missing" Tag="&#xE7BA;"
                                 IsChecked="{Binding CurrentFilter, Converter={StaticResource EqBool}, ConverterParameter=Missing}" />

                    <TextBlock Text="APP" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="18,16,0,6" />
                    <RadioButton Style="{StaticResource SidebarNav}" GroupName="nav" Content="Settings" Tag="&#xE713;"
                                 IsChecked="{Binding CurrentFilter, Converter={StaticResource EqBool}, ConverterParameter=Settings}" />
                </StackPanel>

                <!-- Footer: combined size -->
                <Border Grid.Row="2" Margin="12,0,12,14" Padding="14,12" CornerRadius="10" Background="{StaticResource PanelBgBrush}">
                    <StackPanel>
                        <TextBlock Text="Total on disk" Style="{StaticResource Subtle}" />
                        <TextBlock Text="{Binding CombinedSizeText}" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding GameCountText}" Style="{StaticResource Subtle}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Margin="22,20,22,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderText}" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding VisibleCountText}" Style="{StaticResource Subtle}" Margin="0,2,0,0"
                               Visibility="{Binding IsLibraryVisible, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsLibraryVisible, Converter={StaticResource BoolToVis}}">
                    <Button Content="Import  &#xE70D;" Style="{StaticResource BaseButton}" Margin="0,0,10,0" Click="ImportButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ImportMenu">
                                <MenuItem Header="Import Steam games" Command="{Binding ImportSteamCommand}" />
                                <MenuItem Header="Import Epic games" Command="{Binding ImportEpicCommand}" />
                                <MenuItem Header="Import Start Menu shortcuts" Command="{Binding ImportStartMenuCommand}" />
                                <Separator />
                                <MenuItem Header="Scan a folder or drive…" Command="{Binding ScanFolderCommand}" />
                                <Separator />
                                <MenuItem Header="Auto-detect everything" Command="{Binding ImportAllCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="&#x2795;  Add Game" Style="{StaticResource AccentButton}" Command="{Binding AddGameCommand}" />
                </StackPanel>
            </Grid>

            <!-- Filter / search / view bar -->
            <Grid Grid.Row="1" Margin="22,4,22,8" Visibility="{Binding IsLibraryVisible, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Border Grid.Column="0" MaxWidth="420" HorizontalAlignment="Left" CornerRadius="8"
                        Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 Tag="Search your library…" BorderThickness="0" Background="Transparent" />
                    </Grid>
                </Border>

                <TextBlock Grid.Column="2" Text="Sort" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0,8,0" />
                <ComboBox Grid.Column="3" Width="140" SelectedItem="{Binding SortField}" ItemsSource="{Binding SortFields}"
                          ItemTemplate="{StaticResource SortItemTemplate}" />

                <!-- View toggle -->
                <Border Grid.Column="4" Margin="12,0,0,0" CornerRadius="8" Background="{StaticResource InputBgBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="GridToggle" Content="&#xE8A9;" IsChecked="{Binding IsGridView, Mode=OneWay}"
                                      Command="{Binding SetGridViewCommand}" Style="{StaticResource ViewToggle}" ToolTip="Grid view" />
                        <ToggleButton x:Name="ListToggle" Content="&#xE8FD;" IsChecked="{Binding IsListView, Mode=OneWay}"
                                      Command="{Binding SetListViewCommand}" Style="{StaticResource ViewToggle}" ToolTip="List view" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main content area -->
            <Grid Grid.Row="2" Margin="14,4,14,0">

                <!-- Grid view -->
                <ListBox x:Name="GridList"
                         Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}"
                         ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame}"
                         ItemTemplate="{StaticResource GameCardTemplate}"
                         ItemsPanel="{StaticResource WrapPanelTemplate}"
                         ItemContainerStyle="{StaticResource GameListContainer}"
                         Background="Transparent" BorderThickness="0" Padding="8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         MouseDoubleClick="GamesList_MouseDoubleClick" />

                <!-- List view -->
                <ListBox x:Name="RowList"
                         Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}"
                         ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame}"
                         ItemTemplate="{StaticResource GameRowTemplate}"
                         ItemContainerStyle="{StaticResource GameListContainer}"
                         Background="Transparent" BorderThickness="0" Padding="8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="GamesList_MouseDoubleClick" />

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding AllGames.Count, Converter={StaticResource CountToVis}, ConverterParameter=empty}">
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="52" Foreground="#2E3542"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Your library is empty" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="Add a game, or auto-detect what's installed on this PC."
                               Style="{StaticResource Subtle}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="&#x2795;  Add Game" Style="{StaticResource AccentButton}" Command="{Binding AddGameCommand}" Margin="0,0,10,0" />
                        <Button Content="Auto-detect" Style="{StaticResource BaseButton}" Command="{Binding ImportAllCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- Settings panel -->
                <ScrollViewer Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">

                        <!-- Auto import -->
                        <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Automatic import" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,14" TextWrapping="Wrap"
                                           Text="Find games already on this PC. Every result is shown for review before anything is added." />
                                <WrapPanel>
                                    <Button Content="Scan Steam" Style="{StaticResource BaseButton}" Command="{Binding ImportSteamCommand}" Margin="0,0,8,8" />
                                    <Button Content="Scan Epic" Style="{StaticResource BaseButton}" Command="{Binding ImportEpicCommand}" Margin="0,0,8,8" />
                                    <Button Content="Scan Start Menu" Style="{StaticResource BaseButton}" Command="{Binding ImportStartMenuCommand}" Margin="0,0,8,8" />
                                    <Button Content="Scan a folder…" Style="{StaticResource BaseButton}" Command="{Binding ScanFolderCommand}" Margin="0,0,8,8" />
                                    <Button Content="Auto-detect everything" Style="{StaticResource AccentButton}" Command="{Binding ImportAllCommand}" Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Data -->
                        <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Data" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Everything is stored locally. Nothing about your games is ever sent anywhere."
                                           Style="{StaticResource Subtle}" Margin="0,4,0,12" TextWrapping="Wrap" />
                                <TextBlock Text="Library file" Style="{StaticResource Subtle}" />
                                <TextBlock Text="{Binding Settings.LibraryFile}" Margin="0,2,0,10" TextWrapping="Wrap" FontSize="12" />
                                <WrapPanel>
                                    <Button Content="Open data folder" Style="{StaticResource BaseButton}" Command="{Binding Settings.OpenDataFolderCommand}" Margin="0,0,8,8" />
                                    <Button Content="Open icon cache" Style="{StaticResource BaseButton}" Command="{Binding Settings.OpenIconCacheCommand}" Margin="0,0,8,8" />
                                    <Button Content="Clear icon cache" Style="{StaticResource GhostButton}" Command="{Binding Settings.ClearIconCacheCommand}" Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- About -->
                        <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="About" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Subtle}">
                                    <Run Text="PGameLib v" /><Run Text="{Binding Settings.AppVersion, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="A local, offline launcher. Removing an entry never deletes your game — only the library record here." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="3" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Width="120" Height="4" IsIndeterminate="True"
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="0,0,12,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource Subtle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Content="&#xE72C;  Refresh" Style="{StaticResource GhostButton}" Padding="12,5"
                            Command="{Binding RefreshCommand}" VerticalAlignment="Center"
                            ToolTip="Recalculate sizes and re-check which games are available (F5)" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
